              "path": [
                "article",
                "{{articleId}}"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "{{articleId}}",
                  "description": "Article ID (non-numeric values fall back to 0 and return 404)."
                }
              ]
            },
            "description": "Get a single article by ID.\n\n- 200: `{\"status\":\"success\",\"message\":\"article found\",\"data\":{...}}`\n- 404: `{\"status\":\"failed\",\"message\":\"article not found\",\"data\":null}`\n- 500: server error"
